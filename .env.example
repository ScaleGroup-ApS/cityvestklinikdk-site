# Contact form → CRM (required in production for /kontakt to deliver leads)
# The SSR app POSTs submissions to the CRM's internal endpoint, which stores
# them and emails the clinic. In the cluster these are set in infra/deployment.yaml
# (CRM_API_TOKEN comes from the `crm-internal` secret; SITE_SLUG is templated).
# CRM_API_URL=http://crm-backend.crm-system.svc.cluster.local:5000
# CRM_API_TOKEN=your_internal_api_token
# SITE_SLUG=cityvestklinikdk

# Google Business reviews (optional – uses static fallback in app/lib/google-reviews.ts if not set)
# Get Place ID: open your Business Profile on Google Maps → Share → "Link to this place" or use
# https://developers.google.com/maps/documentation/places/web-service/place-id
# Enable "Places API" in Google Cloud Console and create an API key.
# GOOGLE_PLACE_ID=ChIJ...
# GOOGLE_PLACES_API_KEY=your_api_key
