# Contact form → CRM (required in production for /kontakt to deliver leads)
# The SSR app POSTs submissions to the CRM's internal endpoint, which stores
# them and emails the clinic. In the cluster these are set in infra/deployment.yaml
# (CRM_API_TOKEN comes from the `crm-internal` secret; SITE_SLUG is templated).
# CRM_API_URL=http://crm-backend.crm-system.svc.cluster.local:5000
# CRM_API_TOKEN=your_internal_api_token
# SITE_SLUG=cityvestklinikdk

# Google Business reviews (optional – uses static fallback in app/lib/google-reviews.ts if not set)
# Get Place ID: open your Business Profile on Google Maps → Share → "Link to this place" or use
# https://developers.google.com/maps/documentation/places/web-service/place-id
# Enable "Places API" in Google Cloud Console and create an API key.
# GOOGLE_PLACE_ID=ChIJ...
# GOOGLE_PLACES_API_KEY=your_api_key

# Contact forms: provision both keys and exact hostnames to activate Turnstile.
# Blank keys leave Turnstile inactive; honeypots still apply.
# TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated bare hostnames, e.g. example.dk,www.example.dk
TURNSTILE_HOSTNAMES=
# Explicit provider: altcha, cap, turnstile, or none. Unset preserves legacy settings.
# Each customer/environment/contact surface requires an independent site key.
# CONTACT_SPAM_PROVIDER=altcha
ALTCHA_SITE_KEY=
ALTCHA_SECRET_KEY=
# Server-only origin, e.g. http://altcha.contact-altcha.svc.cluster.local:3001
ALTCHA_VERIFY_BASE_URL=
# Browser-reachable HTTPS origin, e.g. https://altcha.scaledev.dk
ALTCHA_PUBLIC_BASE_URL=

# Optional compatible self-hosted Cap provider.
CAP_SITE_KEY=
CAP_SECRET_KEY=
CAP_VERIFY_BASE_URL=
CAP_PUBLIC_BASE_URL=
